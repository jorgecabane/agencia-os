# NO USES ESTA COPIA: cópiala a vistas/lo-mio.local.base y pon tu slug en `yo`.
# Bases no tiene variable "usuario actual". La vista filtra por la fórmula `yo`, que trae un valor
# de relleno: cada persona la cambia a su slug (ej. "ana") en SU copia local y NO la commitea.
# Opción recomendada: duplica este archivo como vistas/lo-mio.local.base (git lo ignora), edita `yo`
# ahí y úsalo. Obsidian puede reescribir este archivo y borrar comentarios; el aviso también está en
# docs/conectores.md § Obsidian.
filters:
  and:
    - file.inFolder("clientes")
    - tipo == "entregable"
    - responsable == formula.yo
    - estado != "publicado"
    - estado != "cancelado"
formulas:
  yo: '"TU-SLUG"'
properties:
  file.name:
    displayName: Entregable
  cliente:
    displayName: Cliente
  vence:
    displayName: Vence
  estado:
    displayName: Estado
views:
  - type: table
    name: Lo mío
    order:
      - file.name
      - cliente
      - vence
      - estado
    sort:
      - property: vence
        direction: ASC
