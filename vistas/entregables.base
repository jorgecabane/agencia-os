filters:
  and:
    - file.inFolder("clientes")
    - tipo == "entregable"
properties:
  vence:
    displayName: Vence
views:
  - type: kanban-view
    name: Por estado
    groupByProperty: note.estado
    columnOrders:
      note.estado: [brief, en_curso, revision, aprobado, publicado, cancelado]
    order:
      - file.name
      - cliente
      - vence
      - responsable
