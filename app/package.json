{
  "name": "agencia-os",
  "version": "0.1.0",
  "private": true,
  "description": "App de escritorio de agencia-os",
  "main": "out/shell/main.js",
  "scripts": {
    "dev": "pnpm build:ui && pnpm build:shell && electron .",
    "build:ui": "vite build",
    "build:shell": "tsc -p tsconfig.json",
    "dist": "pnpm build:ui && pnpm build:shell && electron-builder --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.ui.json && tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck && vitest run",
    "smoke": "pnpm build:shell && node tests/smoke.mjs"
  },
  "devDependencies": {
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "lucide-react": "1.62.0",
    "node-diff3": "3.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fast-glob": "3.3.3",
    "yaml": "2.9.1"
  }
}
